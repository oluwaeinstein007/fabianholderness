# Copy this file to .env for local development (`vercel dev`), and set the
# same values as Environment Variables in the Vercel project dashboard for
# previews/production.

# Public site origin, used to build canonical/OG/sitemap URLs (no trailing
# slash). Resolution order (see scripts/resolve-site-url.mjs):
#   1. This variable, if set.
#   2. Vercel's auto-injected VERCEL_URL — so a fresh deploy with no custom
#      domain attached yet still gets correct, live URLs out of the box.
#   3. http://localhost:5173, for local builds off Vercel.
# Leave this unset until fabianholderness.com is actually attached as the
# project's domain in Vercel, then set it here and in the Vercel dashboard.
VITE_SITE_URL=

# Resend (https://resend.com) — used by api/contact.ts to send contact-form
# submissions by email. Create an API key in the Resend dashboard.
RESEND_API_KEY=

# Inbox that contact-form submissions are delivered to.
CONTACT_TO_EMAIL=info@fabianholderness.com

# Sender address for outgoing mail. Must be on a domain verified in Resend;
# until you verify fabianholderness.com there, leave this unset to fall back
# to Resend's shared sandbox sender (onboarding@resend.dev).
CONTACT_FROM_EMAIL=
